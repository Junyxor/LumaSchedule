{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaSchedule",
  "version": "0.1.0",
  "identifier": "com.lumaschedule.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaSchedule",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://*; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 26 },
    "resources": { "../vendor/shiguang_warehouse/": "shiguang_warehouse/" }
  }
}
